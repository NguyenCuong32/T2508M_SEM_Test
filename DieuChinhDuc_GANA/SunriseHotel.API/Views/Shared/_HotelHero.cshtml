<section class="hero" aria-labelledby="page-title">
    <div class="shell hero-inner">
        <div class="hero-copy">
            <p class="eyebrow">@ViewData["Eyebrow"]</p>
            <h1 id="page-title">@ViewData["Title"]</h1>
            <p class="hero-description">@ViewData["Description"]</p>
        </div>
        <img class="hero-art" src="~/images/hotel-arches.svg" asp-append-version="true" alt="" width="640" height="360">
    </div>
</section>
