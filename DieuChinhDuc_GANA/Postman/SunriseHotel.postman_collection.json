{
  "info": {
    "name": "Sunrise Hotel",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "phone",
      "value": "0901234567"
    },
    {
      "key": "from",
      "value": "2026-11-01"
    },
    {
      "key": "to",
      "value": "2026-11-30"
    }
  ],
  "item": [
    {
      "name": "askhotel · Hỏi lễ tân",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Hồ bơi ở tầng mấy và bữa sáng phục vụ lúc nào?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/ai/ask"
      }
    },
    {
      "name": "parsebooking · Tạo booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Tôi là Nguyễn Văn An, sđt {{phone}}, muốn đặt 1 phòng đôi từ 20/11/2026 đến 22/11/2026 cho 2 người\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/bookings/parse"
      }
    },
    {
      "name": "bookingassistant · Kiểm tra phòng",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Còn phòng Suite nào trống từ 24/12/2026 đến 26/12/2026 không?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/assistant/chat"
      }
    },
    {
      "name": "bookingassistant · Tra booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Tra các đơn đặt phòng theo số điện thoại {{phone}}.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/assistant/chat"
      }
    },
    {
      "name": "bookingassistant · Hủy booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Hủy giúp tôi booking số {{bookingId}}.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/assistant/chat"
      }
    },
    {
      "name": "getbookingreport · Báo cáo",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reports/bookings?from={{from}}&to={{to}}"
      }
    }
  ]
}
