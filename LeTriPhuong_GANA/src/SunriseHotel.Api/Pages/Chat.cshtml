@page "/chat"
@{
    ViewData["Title"] = "Trợ lý AI";
    var mode = string.Equals(Request.Query["mode"], "assistant", StringComparison.OrdinalIgnoreCase) ? "assistant" : "ask";
}

<div class="page-head">
    <h1>Trợ lý AI</h1>
    <p class="muted">Hỏi đáp về khách sạn hoặc nhờ trợ lý kiểm tra phòng trống, tra cứu và hủy booking.</p>
</div>

<div class="chat-layout" data-mode="@mode" id="chat-root">
    <div>
        <div class="tabs" role="tablist" aria-label="Chọn trợ lý">
            <button class="tab" role="tab" data-mode="ask" aria-selected="@(mode == "ask" ? "true" : "false")">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
                Lễ tân AI
            </button>
            <button class="tab" role="tab" data-mode="assistant" aria-selected="@(mode == "assistant" ? "true" : "false")">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>
                Trợ lý đặt phòng
            </button>
        </div>

        <section class="card chat-box">
            <div class="chat-messages" id="messages" aria-live="polite"></div>
            <form class="chat-input" id="chat-form" autocomplete="off">
                <label for="chat-text" class="sr-only">Tin nhắn</label>
                <input class="input" id="chat-text" maxlength="1000" placeholder="Nhập câu hỏi của bạn…" required />
                <button class="btn btn-primary" type="submit" id="send-btn">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg>
                    Gửi
                </button>
            </form>
        </section>
    </div>

    <aside>
        <div class="card side-card">
            <h3>Gợi ý câu hỏi</h3>
            <div class="suggestions" id="suggestions"></div>
        </div>
        <div class="card side-card" id="about-card"></div>
    </aside>
</div>

@section Scripts {
<script>
(() => {
    const MODES = {
        ask: {
            endpoint: "/api/ai/ask",
            field: "question",
            greet: "Xin chào quý khách! Tôi là lễ tân AI của Sunrise Hotel. Quý khách cần hỗ trợ thông tin gì về khách sạn ạ?",
            placeholder: "Ví dụ: Mấy giờ được nhận phòng?",
            suggestions: [
                "Mấy giờ tôi được nhận phòng?",
                "Khách sạn có phục vụ bữa sáng không?",
                "Phòng Suite có đưa đón sân bay không?",
                "Hồ bơi nằm ở tầng mấy?",
                "Địa chỉ khách sạn ở đâu?"
            ],
            about: `<h3>Lễ tân AI</h3>
                <p class="muted" style="margin:8px 0 0;font-size:.88rem">Chỉ trả lời câu hỏi về Sunrise Hotel. Câu hỏi ngoài phạm vi sẽ được từ chối lịch sự.</p>
                <ul><li>Giờ nhận / trả phòng</li><li>Bữa sáng, hồ bơi</li><li>Đưa đón sân bay</li><li>Địa chỉ, liên hệ</li></ul>`
        },
        assistant: {
            endpoint: "/api/assistant/chat",
            field: "message",
            greet: "Chào bạn! Tôi có thể kiểm tra phòng trống, tra cứu booking theo số điện thoại hoặc hủy booking giúp bạn.",
            placeholder: "Ví dụ: Còn phòng Suite trống từ 24/12 đến 26/12 không?",
            suggestions: [
                "Còn phòng Suite nào trống từ 24/12 đến 26/12 không?",
                "Phòng đôi còn trống từ 20/11 đến 22/11 không?",
                "Tra cứu booking của số 0901234567",
                "Hủy giúp tôi booking số 3"
            ],
            about: `<h3>Trợ lý đặt phòng</h3>
                <p class="muted" style="margin:8px 0 0;font-size:.88rem">Gemini gọi các hàm C# của khách sạn (Function Calling) rồi tổng hợp câu trả lời.</p>
                <ul><li><code>CheckAvailability</code></li><li><code>GetBookingsByPhone</code></li><li><code>CancelBooking</code></li></ul>`
        }
    };

    const root = document.getElementById("chat-root");
    const list = document.getElementById("messages");
    const form = document.getElementById("chat-form");
    const input = document.getElementById("chat-text");
    const sendBtn = document.getElementById("send-btn");
    const sugBox = document.getElementById("suggestions");
    const about = document.getElementById("about-card");
    const { esc } = window.hotel;
    const threads = { ask: [], assistant: [] };
    let mode = root.dataset.mode;
    let busy = false;

    function bubble(role, html, extra = "") {
        const el = document.createElement("div");
        el.className = `msg ${role}`;
        el.innerHTML = `<div class="avatar">${role === "user" ? "Bạn" : "AI"}</div><div><div class="bubble">${html}</div>${extra}</div>`;
        return el;
    }

    function fnCallsHtml(calls) {
        if (!calls?.length) return "";
        return `<div class="fn-calls">${calls.map(c => `
            <details class="fn-call">
                <summary>⚙ Đã gọi hàm <b>${esc(c.name)}</b></summary>
                <pre>${esc(JSON.stringify({ arguments: c.arguments, result: c.result }, null, 2))}</pre>
            </details>`).join("")}</div>`;
    }

    function render() {
        const cfg = MODES[mode];
        list.innerHTML = "";
        list.append(bubble("bot", esc(cfg.greet)));
        threads[mode].forEach(m => list.append(m));
        input.placeholder = cfg.placeholder;
        about.innerHTML = cfg.about;
        sugBox.innerHTML = "";
        cfg.suggestions.forEach(s => {
            const b = document.createElement("button");
            b.type = "button"; b.className = "chip"; b.textContent = s;
            b.onclick = () => send(s);
            sugBox.append(b);
        });
        document.querySelectorAll(".tab").forEach(t => t.setAttribute("aria-selected", t.dataset.mode === mode));
        list.scrollTop = list.scrollHeight;
    }

    function push(node) {
        threads[mode].push(node);
        list.append(node);
        list.scrollTop = list.scrollHeight;
    }

    async function send(text) {
        text = text.trim();
        if (!text || busy) return;
        busy = true; sendBtn.disabled = true; input.value = "";
        const currentMode = mode;
        const cfg = MODES[currentMode];
        push(bubble("user", esc(text)));

        const typing = document.createElement("div");
        typing.className = "msg bot";
        typing.innerHTML = `<div class="avatar">AI</div><div class="bubble typing"><i></i><i></i><i></i></div>`;
        list.append(typing); list.scrollTop = list.scrollHeight;

        let node;
        try {
            const data = await window.hotel.postJson(cfg.endpoint, { [cfg.field]: text });
            const reply = data.answer ?? data.reply ?? "";
            node = bubble("bot", esc(reply), fnCallsHtml(data.functionCalls));
        } catch (e) {
            node = bubble("bot error", esc(e.message));
        } finally {
            typing.remove();
            busy = false; sendBtn.disabled = false;
        }
        threads[currentMode].push(node);
        if (mode === currentMode) { list.append(node); list.scrollTop = list.scrollHeight; }
        input.focus();
    }

    form.addEventListener("submit", e => { e.preventDefault(); send(input.value); });
    document.querySelectorAll(".tab").forEach(t => t.addEventListener("click", () => {
        mode = t.dataset.mode;
        window.history.replaceState(null, "", `/chat?mode=${mode}`);
        render();
    }));

    render();
})();
</script>
}
