@model IEnumerable<ComicSystem.Models.Customer>

@{
    ViewData["Title"] = "Danh sách Khách hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people me-2"></i>Danh sách Khách hàng đã đăng ký</h2>
    <a asp-action="Register" class="btn btn-success">
        <i class="bi bi-person-plus me-1"></i> Đăng ký khách hàng mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Họ và tên</th>
                        <th>Số điện thoại</th>
                        <th>Ngày đăng ký</th>
                        <th style="width: 120px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có khách hàng nào đăng ký.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model) {
                        <tr>
                            <td>@item.CustomerID</td>
                            <td class="fw-bold">@item.FullName</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.RegisterDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <a asp-action="Delete" asp-route-id="@item.CustomerID" class="btn btn-outline-danger btn-sm" title="Xóa khách hàng">
                                    <i class="bi bi-trash me-1"></i>Xóa
                                </a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
