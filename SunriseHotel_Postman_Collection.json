    "name": "Sunrise Hotel - AI Booking & Management API",
    "description": "Bộ sưu tập kiểm thử toàn diện 4 API Endpoints theo đề thi Practical Exam: Generative AI for .NET Developers with Google AI - SET02 (Sunrise Hotel).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5013",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    }
