@baseUrl = http://localhost:7071/api

### Register a player
POST {{baseUrl}}/registerplayer
Content-Type: application/json

{
  "playerName": "Player 4",
  "fullName": "Demo Player Four",
  "age": 21,
  "level": 1,
  "email": "player4@example.com"
}

### Create an asset
POST {{baseUrl}}/createasset
Content-Type: application/json

{
  "assetName": "Shield 1",
  "levelRequire": 3
}

### Get all player asset assignments
GET {{baseUrl}}/getassetsbyplayer
Accept: application/json

### Filter the report by player
GET {{baseUrl}}/getassetsbyplayer?playerId=11111111-1111-1111-1111-111111111111
Accept: application/json
