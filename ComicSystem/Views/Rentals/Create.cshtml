@model ComicSystem.Models.RentalViewModel

@{
    ViewData["Title"] = "Rent Book";
}

<div class="container mt-4">
    <h2>Rent Book</h2>
    <hr />

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label class="form-label">Customer</label>
                    <select asp-for="CustomerID" class="form-select" asp-items="ViewBag.CustomerID">
                        <option value="">-- Select Customer --</option>
                    </select>
                    <span asp-validation-for="CustomerID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Comic Book</label>
                    <select asp-for="ComicBookID" class="form-select" asp-items="ViewBag.ComicBookID">
                        <option value="">-- Select Comic Book --</option>
                    </select>
                    <span asp-validation-for="ComicBookID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RentalDate" class="form-label">Rental Date</label>
                    <input asp-for="RentalDate" type="date" class="form-control" />
                    <span asp-validation-for="RentalDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ReturnDate" class="form-label">Return Date</label>
                    <input asp-for="ReturnDate" type="date" class="form-control" />
                    <span asp-validation-for="ReturnDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label">Quantity</label>
                    <input asp-for="Quantity" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Submit Rental</button>
            </form>
        </div>
    </div>
</div>