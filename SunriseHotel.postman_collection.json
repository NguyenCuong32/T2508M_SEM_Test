            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Khách sạn có bể bơi không và ở tầng mấy? Giờ ăn sáng thế nào?\"\n}"
        },
        "url": {
          "raw": "http://localhost:5130/api/ai/ask",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5130",
          "path": ["api", "ai", "ask"]
        }
      }
    },
